<?xml version="1.0" encoding="utf-8"?>
<!-- Repositório público: CI roda no GitHub (ubuntu-latest). O fork
     Pomelo.EntityFrameworkCore.MySql 10.0.0 não existe no nuget.org —
     o nupkg versionado em pkg/ supre o restore do target net10.0.
     (net7.0 usa Pomelo 9.x que existe no nuget.org.) -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="sufficit-pomelo-fork" value="pkg" />
  </packageSources>
</configuration>
